# Patterns that are specific to a text editor, IDE, operating system, or user
# environment are not added here. They should be added to your local gitignore
# file instead:
# https://docs.github.com/en/get-started/git-basics/ignoring-files#configuring-ignored-files-for-all-repositories-on-your-computer

# Build subdirectories.
/*build*
!/build-aux
!/build_msvc

*.pyc

# CMake-generated functional test config
/test/config.ini

# Only ignore unexpected patches
*.patch
!contrib/guix/patches/*.patch
!depends/patches/**/*.patch

/CMakeUserPresets.json

# Previous releases
/releases

# cargo default target dir
target/

/guix-build-*

/ci/scratch/
regtest-data/

# TLC model-checking state dumps
spec/states/

# Tools artefacts (from bitcoin-ladder-script merge)
tools/test-results*.json
tools/dashboard.html
tools/generate-tx-docs.py

# TLA+ tooling (download locally, never commit)
spec/jdk-*/
spec/*.tar.gz
spec/tla2tools.jar
proxy/analytics.db

# Internal review notes — never published to the public repo.
doc/audit/
doc/audit*.md
doc/ladder-script/audit*.md
doc/ladder-script/plan_*.md
